# Public Supabase project URL used by browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=
# Public Supabase anon/publishable key. This is safe to expose to browser code.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase service-role key. Never expose this to client modules.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only HMAC pepper for contact/chat rate-limit identity and visitor-token hashing.
CHAT_TOKEN_PEPPER=
# Server-only Vercel Cron bearer secret for daily chat retention. Generate a
# random value with at least 32 characters outside committed env files.
CRON_SECRET=
# Canonical site origin used for OAuth allowlists and callback configuration.
NEXT_PUBLIC_SITE_URL=
# Public Cloudinary cloud name used only for the approved image route.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Live chat stays disabled until the owner completes the staging Discord and
# Supabase gates documented in docs/discord-chat-setup.md.
CHAT_ENABLED=false
# Discord application/bot identity and fixed private chat destination.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHAT_CHANNEL_ID=
# Comma-separated Discord responder role IDs; IDs only, never role names.
DISCORD_CHAT_STAFF_ROLE_IDS=
