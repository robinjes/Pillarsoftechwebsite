# Public Supabase project URL used by browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=
# Public Supabase anon/publishable key. This is safe to expose to browser code.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase service-role key. Never expose this to client modules.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only HMAC pepper for contact/chat rate-limit identity and visitor-token hashing.
CHAT_TOKEN_PEPPER=
# Canonical site origin used for OAuth allowlists and callback configuration.
NEXT_PUBLIC_SITE_URL=
# Public Cloudinary cloud name used only for the approved image route.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudflare Turnstile widget (Managed mode). Add your website domains in Cloudflare.
# Public site key is compiled into the frontend; rebuild after setting it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only secret. Never prefix this with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=
# Optional comma-separated exact hostnames (no protocol); defaults to canonical site + www.
TURNSTILE_ALLOWED_HOSTNAMES=
